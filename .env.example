# Copy this file to .env and fill in real values. Never commit .env.
# The app checks these when it starts and lists anything missing or invalid.

# Postgres connection string: Neon (Connect -> Connection string), Supabase, RDS, your own
# server... With docker compose this is set for you (docker-compose.yml).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional: "neon" or "postgres". Empty: Neon's fast HTTP driver for *.neon.tech addresses, a
# normal connection for everything else.
DATABASE_DRIVER=""

# Random string used to sign session cookies (32+ characters)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The URL your app runs at, without a trailing slash
BETTER_AUTH_URL="http://localhost:3000"

# Resend API key for sending real emails. Optional in development (emails are printed in the
# terminal instead), required in production.
RESEND_API_KEY=""
# Optional: sender address (must be a domain verified in Resend)
EMAIL_FROM="Fleetdesk <onboarding@resend.dev>"

# Optional: "true" for a public demo without emails (no verification, invite links shown on
# screen, a banner with the sample logins). Never on for a real business.
DEMO_MODE=""

# Where uploaded photos go (cars, inspections, driver's licenses, signatures):
#   "database" (default): in Postgres. Nothing to set up; fine for a small fleet.
#   "local": in a folder on the server (STORAGE_LOCAL_DIR, default ./uploads). Docker only,
#            not Vercel.
#   "s3": any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, MinIO).
STORAGE_DRIVER=""
STORAGE_LOCAL_DIR=""
# For "s3". R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto".
# Keep the bucket private: the app serves files itself and checks who may see them.
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional: online payments with Stripe (https://stripe.com). Without a key, customers pay at
# pickup. Use test keys (sk_test_...) while trying it out.
# 1. Developers > API keys: copy the secret key.
# 2. Developers > Webhooks: add https://<your-domain>/api/webhooks/stripe with the events
#    checkout.session.completed and checkout.session.expired, and copy its signing secret.
# 3. In the app: Settings > Payments, choose whether customers pay online, at pickup, or either.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Protects the daily job (reminder emails, the staff summary, cleaning up unused uploads).
# A long random string. Required in production. On Vercel, vercel.json runs the job every
# morning; elsewhere call GET /api/cron/daily once a day with "Authorization: Bearer <secret>".
CRON_SECRET=""
